# Copy to .env and fill in any providers you have. Used by `npm run build`
# (defaults baked into the extension) and by `npm run test:e2e` (real Jev calls).

# typesafe | openrouter | vercel | cloudflare  (empty = first provider with a key)
# If it fails, the extension falls back to your other providers that have keys.
VITE_JEV_PROVIDER=

VITE_TYPESAFE_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_AI_GATEWAY_API_KEY=
VITE_CLOUDFLARE_API_TOKEN=
VITE_CLOUDFLARE_ACCOUNT_ID=
